{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/whatsapp-outbox",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/sms-worker",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/call-recordings-cleanup",
      "schedule": "17 3 * * *"
    }
  ]
}

